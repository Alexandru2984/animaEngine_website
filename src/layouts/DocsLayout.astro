---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbs } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  slug: string;
  sources: { label: string; url: string }[];
  checkedAgainst: string;
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, slug, sources, checkedAgainst, headings } = Astro.props;
const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const index = pages.findIndex((p) => p.id === slug);
const prev = index > 0 ? pages[index - 1] : undefined;
const next = index >= 0 && index < pages.length - 1 ? pages[index + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  title={`${title} · Docs`}
  description={description}
  ogType="article"
  jsonLd={[
    breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'Docs', path: '/docs/' },
      { name: title, path: `/docs/${slug}/` },
    ]),
  ]}
>
  <div class="container docs">
    <aside class="sidebar">
      <nav aria-label="Documentation">
        <p class="side-title"><a href="/docs/">Documentation</a></p>
        <ul>
          {
            pages.map((p) => (
              <li>
                <a href={`/docs/${p.id}/`} aria-current={p.id === slug ? 'page' : undefined}>
                  {p.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>

    <article class="content">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/docs/">Docs</a></li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
      <h1>{title}</h1>
      <p class="lead">{description}</p>

      {
        toc.length > 2 && (
          <nav class="toc" aria-label="On this page">
            <p>On this page</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="prose">
        <slot />
      </div>

      <footer class="source">
        <Icon name="book" size={20} />
        <p>
          Checked against animaEngine {checkedAgainst}. Based on
          {
            sources.map((s, i) => (
              <>
                {i > 0 && (i === sources.length - 1 ? ' and ' : ', ')}
                <a href={s.url} rel="noopener noreferrer">
                  {s.label}
                </a>
              </>
            ))
          }
          in the animaEngine repository, which is the reference when the two differ.
        </p>
      </footer>

      <nav class="pager" aria-label="More documentation">
        {
          prev ? (
            <a class="pager-link" href={`/docs/${prev.id}/`}>
              <span>Previous</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="pager-link next" href={`/docs/${next.id}/`}>
              <span>Next</span>
              {next.data.title}
            </a>
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>

<style>
  .docs {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 48px;
    padding-block: 48px clamp(64px, 9vw, 120px);
  }

  .sidebar nav {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .side-title {
    margin: 0 0 10px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .side-title a {
    color: var(--faint);
    text-decoration: none;
  }

  .sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .sidebar li a {
    display: block;
    margin-left: -1px;
    padding: 8px 14px;
    border-left: 2px solid transparent;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .sidebar li a:hover {
    color: var(--text);
  }

  .sidebar li a[aria-current='page'] {
    border-left-color: var(--accent);
    color: var(--text);
  }

  .crumbs ol {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    color: var(--faint);
    font-size: 0.9rem;
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
  }

  .crumbs a {
    color: var(--muted);
  }

  .content h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .content > .lead {
    max-width: 62ch;
  }

  .toc {
    margin: 28px 0 8px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    max-width: 72ch;
  }

  .toc p {
    margin: 0 0 6px;
    color: var(--faint);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .toc ul {
    columns: 2;
    margin: 0;
    padding-left: 1.1em;
  }

  .toc li {
    margin: 4px 0;
  }

  .prose {
    margin-top: 32px;
  }

  .source {
    display: flex;
    gap: 12px;
    max-width: 72ch;
    margin-top: 48px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .source :global(svg) {
    flex: none;
    color: var(--accent-strong);
  }

  .source p {
    margin: 0;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    max-width: 72ch;
    margin-top: 24px;
  }

  .pager-link {
    display: grid;
    gap: 2px;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .pager-link span {
    color: var(--faint);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .pager-link:hover {
    border-color: var(--accent);
  }

  .pager-link.next {
    margin-left: auto;
    text-align: right;
  }

  @media (max-width: 900px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 32px;
    }

    .sidebar nav {
      position: static;
    }

    .sidebar ul {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      border: 0;
    }

    .sidebar li a {
      margin: 0;
      padding: 6px 12px;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.88rem;
    }

    .sidebar li a[aria-current='page'] {
      border-color: var(--accent);
    }

    .toc ul {
      columns: 1;
    }
  }
</style>
