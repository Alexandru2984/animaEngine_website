---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import InlineText from '../components/InlineText.astro';
import { featureSections, supportedAssets } from '../data/features';
import { breadcrumbs } from '../lib/structured-data';
---

<BaseLayout
  title="Features"
  description="Everything animaEngine does: characters from any picture or short video, behaviours and scripts, edit mode, scenes, reminders, desktop integration, accessibility and privacy."
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Features', path: '/features/' }])]}
>
  <PageHeader title="Everything it does, in one place">
    <p>Every item on this page is in animaEngine today. Most of the livelier parts are off until you turn them on.</p>
  </PageHeader>
  <nav class="container toc" aria-label="On this page">
    <ul>
      {featureSections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
      <li><a href="#formats">Supported files</a></li>
    </ul>
  </nav>

  <div class="container sections">
    {
      featureSections.map((section) => (
        <section class="feature-section" id={section.id} aria-labelledby={`${section.id}-title`}>
          <header>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <p class="muted">{section.intro}</p>
          </header>
          <dl class="items">
            {section.items.map((item) => (
              <div class="item">
                <dt>{item.title}</dt>
                <dd>
                  <InlineText text={item.text} />
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }

    <section class="feature-section" id="formats" aria-labelledby="formats-title">
      <header>
        <h2 id="formats-title">Supported files</h2>
        <p class="muted">What you can drop on the overlay. Larger or other files are refused with a message that says why.</p>
      </header>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col">Type</th><th scope="col">Extensions</th><th scope="col">Notes</th></tr>
          </thead>
          <tbody>
            {
              supportedAssets.map((row) => (
                <tr>
                  <th scope="row">{row.type}</th>
                  <td><code>{row.extensions}</code></td>
                  <td>{row.notes}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <aside class="next">
      <h2>See it, then try it</h2>
      <p class="muted">Recordings of the real app, or the download for your system.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/download/"><Icon name="download" /> Download</a>
        <a class="btn" href="/showcase/">Showcase</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .toc ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: 0;
    padding: var(--s-5) 0 0;
  }

  .toc a {
    color: var(--haze);
    font-weight: 700;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--moon);
    text-decoration: underline;
  }

  .sections {
    padding-bottom: clamp(72px, 10vw, 136px);
  }

  .feature-section {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-5) clamp(32px, 6vw, 96px);
    padding-block: var(--s-8);
    border-top: 1px solid var(--line);
  }

  .feature-section:first-of-type {
    margin-top: var(--s-7);
  }

  .feature-section header {
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
  }

  .feature-section header h2 {
    font-size: var(--t-2xl);
  }

  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-6);
    margin: 0;
  }

  dt {
    margin-bottom: var(--s-2);
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 760;
    letter-spacing: -0.01em;
  }

  dd {
    margin: 0;
    color: var(--haze);
  }

  .next {
    margin-top: var(--s-7);
    padding-top: var(--s-7);
    border-top: 1px solid var(--line);
  }

  .next h2 {
    margin-bottom: var(--s-2);
  }

  .next .btn-row {
    margin-top: var(--s-5);
  }

  @media (max-width: 900px) {
    .feature-section {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature-section header {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .items {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
