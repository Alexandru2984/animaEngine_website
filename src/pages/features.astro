---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import InlineText from '../components/InlineText.astro';
import { featureSections, supportedAssets } from '../data/features';
import { breadcrumbs } from '../lib/structured-data';
---

<BaseLayout
  title="Features"
  description="Everything animaEngine does: characters from any picture or short video, behaviours and scripts, edit mode, scenes, reminders, desktop integration, accessibility and privacy."
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Features', path: '/features/' }])]}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Features</p>
      <h1>Everything it does, in one place</h1>
      <p class="lead">
        Every item on this page is in animaEngine 1.5.1 today. Most of the livelier parts are off until you turn them on.
      </p>
      <nav class="toc" aria-label="On this page">
        <ul>
          {featureSections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
          <li><a href="#formats">Supported files</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <div class="container sections">
    {
      featureSections.map((section) => (
        <section class="feature-section" id={section.id} aria-labelledby={`${section.id}-title`}>
          <header>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <p class="muted">{section.intro}</p>
          </header>
          <dl class="items">
            {section.items.map((item) => (
              <div class="item">
                <dt>
                  <Icon name="check" size={18} />
                  {item.title}
                </dt>
                <dd>
                  <InlineText text={item.text} />
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }

    <section class="feature-section" id="formats" aria-labelledby="formats-title">
      <header>
        <h2 id="formats-title">Supported files</h2>
        <p class="muted">What you can drop on the overlay. Larger or other files are refused with a message that says why.</p>
      </header>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col">Type</th><th scope="col">Extensions</th><th scope="col">Notes</th></tr>
          </thead>
          <tbody>
            {
              supportedAssets.map((row) => (
                <tr>
                  <th scope="row">{row.type}</th>
                  <td><code>{row.extensions}</code></td>
                  <td>{row.notes}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <aside class="next panel">
      <div>
        <h2>See it, then try it</h2>
        <p class="muted">Recordings of the real app, or the download for your system.</p>
      </div>
      <div class="btn-row">
        <a class="btn" href="/showcase/">Showcase</a>
        <a class="btn btn-primary" href="/download/"><Icon name="download" /> Download</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .toc ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
  }

  .toc a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .sections {
    padding-bottom: clamp(64px, 9vw, 120px);
  }

  .feature-section {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: 24px 48px;
    padding-block: 48px;
    border-top: 1px solid var(--border);
  }

  .feature-section header h2 {
    font-size: 1.6rem;
  }

  .feature-section header {
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
  }

  .item {
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  dt {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-weight: 750;
  }

  dt :global(svg) {
    color: var(--ok);
    flex: none;
  }

  dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 24px;
    padding: 28px;
  }

  .next h2 {
    font-size: 1.4rem;
    margin-bottom: 4px;
  }

  .next p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .feature-section {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature-section header {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .items {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
