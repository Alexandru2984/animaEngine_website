---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ClipShowcase from '../components/ClipShowcase.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import ModelSheet from '../components/ModelSheet.astro';
import { breadcrumbs } from '../lib/structured-data';
import { clipPoster } from '../lib/posters';
import { clips } from '../data/media';

const firstPoster = await clipPoster(clips[0]!);
---

<BaseLayout
  title="Showcase"
  description="Recordings and screenshots of animaEngine running on a Linux desktop, and the ten built-in characters walking, falling, dangling and asleep."
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Showcase', path: '/showcase/' }])]}
  preloadImage={firstPoster.src}
>
  <PageHeader title="The real app, recorded">
    <p>Every clip and screenshot here was recorded from animaEngine on the project's test rig. Nothing is mocked up.</p>
  </PageHeader>

  <section class="section first" aria-labelledby="clips-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="clips-title">Clips</h2>
        <p>Silent, a few seconds each. They pause when you scroll away.</p>
      </div>
      <ClipShowcase idPrefix="clips" />
    </div>
  </section>

  <section class="section shots" aria-labelledby="shots-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="shots-title">Screenshots</h2>
        <p>Select one to see it at full size.</p>
      </div>
      <ScreenshotGallery />
    </div>
  </section>

  <section class="section" aria-labelledby="characters-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="characters-title">Ten built-in characters</h2>
        <p>
          Each one has its own drawings for standing, walking, being picked up, falling and sleeping: the same sheets the app
          plays. Or drop in a picture of your own.
        </p>
      </div>
      <ModelSheet />
      <p class="more"><a href="/download/">Get them on your desktop</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .first {
    padding-top: var(--s-7);
  }

  .shots {
    background: var(--dusk);
  }

  .more {
    margin: var(--s-7) 0 0;
    font-weight: 700;
  }
</style>
