---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stage from '../components/Stage.astro';
import FeatureActs from '../components/FeatureActs.astro';
import ModelSheet from '../components/ModelSheet.astro';
import CompatibilityTable from '../components/CompatibilityTable.astro';
import ArchitectureSection from '../components/ArchitectureSection.astro';
import PlatformDownloads from '../components/PlatformDownloads.astro';
import Icon from '../components/Icon.astro';
import { links, site } from '../data/site';
import { getDownloadContext } from '../lib/site-downloads';
import { PLATFORM_OSES } from '../lib/downloads';
import { formatDate, isoDay } from '../lib/format';
import { softwareApplication } from '../lib/structured-data';
import type { CastMember } from '../data/stage';

const ctx = getDownloadContext();
const version = ctx.latest?.version;

const heroCast: CastMember[] = [
  { name: 'cat', kind: 'walker' },
  { name: 'frog', kind: 'walker' },
  { name: 'bunny', kind: 'walker', wideOnly: true },
  { name: 'slime', kind: 'walker' },
  { name: 'ghost', kind: 'floater', wideOnly: true },
  { name: 'star', kind: 'floater', wideOnly: true },
  { name: 'heart', kind: 'floater', wideOnly: true },
];
const ledgeCast: CastMember[] = [
  { name: 'robot', kind: 'walker' },
  { name: 'mushroom', kind: 'walker', wideOnly: true },
  { name: 'cloud', kind: 'walker' },
];
---

<BaseLayout description={site.description} jsonLd={[softwareApplication(ctx.latest)]}>
  <Stage class="hero" cast={heroCast} skyTop={24}>
    <div class="container hero-inner">
      <div class="hero-copy" data-stage-avoid>
        <h1>Animated characters that live on your desktop</h1>
        <p class="hero-lead">
          They walk, bounce and doze over your windows, and every click goes straight through to your work. A native app,
          written in Rust, free and open source.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/download/" data-os-cta>
            <Icon name="download" />
            <span data-os-cta-label>Download</span>
          </a>
          <a class="btn" href={links.repo} rel="noopener noreferrer">
            <Icon name="github" />
            <span>Source on GitHub</span>
          </a>
        </div>
        <p class="hero-meta">
          {version ? `Version ${version} for Linux. Windows is new and experimental.` : 'For Linux. Windows is new and experimental.'}
        </p>
        <p class="hero-note" data-os-cta-note hidden></p>
      </div>
    </div>
    <p class="stage-hint container">
      <span data-stage-avoid>These are animaEngine's own characters. Click one.</span>
    </p>
  </Stage>

  <section class="section acts-section" id="features" aria-labelledby="features-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="features-title">What they get up to</h2>
        <p>Recordings of the real app. Most of the livelier parts are off until you turn them on.</p>
      </div>
      <FeatureActs />
      <p class="more"><a href="/features/">Every feature, in detail</a></p>
    </div>
  </section>

  <section class="section roster" id="characters" aria-labelledby="characters-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="characters-title">Ten characters come with it</h2>
        <p>
          Each has its own drawings for standing, walking, being picked up, falling and sleeping. These are the sheets the app
          plays. Or drop in a picture of your own.
        </p>
      </div>
      <ModelSheet />
    </div>
  </section>

  <section class="section" id="compatibility" aria-labelledby="compat-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="compat-title">Where it runs</h2>
        <p>Linux first. Each status is what the project itself says about release {version ?? 'its latest release'}.</p>
      </div>
      <CompatibilityTable />
      <p class="more"><a href="/docs/linux-desktops/">X11, Wayland and the known limitations</a></p>
    </div>
  </section>

  <section class="section how" id="architecture" aria-labelledby="arch-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="arch-title">Quiet when nothing moves</h2>
        <p>A desktop companion runs from login to shutdown, so animaEngine is built to cost next to nothing while it waits.</p>
      </div>
      <ArchitectureSection />
    </div>
  </section>

  <section class="get" id="download" aria-labelledby="download-title">
    <Stage scenery="ledge" cast={ledgeCast} entrance="none" size={{ wide: 76, narrow: 60 }}>
      <div class="container get-inner">
        <div class="get-head">
          <h2 id="download-title">Get animaEngine{version && ` ${version}`}</h2>
          <p>
            {
              ctx.latest ? (
                <>
                  Released <time datetime={isoDay(ctx.latest.publishedAt)}>{formatDate(ctx.latest.publishedAt)}</time>. Free and
                  open source under the MIT licence.
                </>
              ) : (
                <>No downloadable release has been published yet.</>
              )
            }
          </p>
          <div class="btn-row">
            <a class="btn btn-primary" href="/download/" data-os-cta>
              <Icon name="download" />
              <span data-os-cta-label>Download</span>
            </a>
            <a class="link" href="/download/#verify">Checksums and install steps</a>
          </div>
        </div>
        <div class="get-list">
          {
            PLATFORM_OSES.map((os) => (
              <PlatformDownloads
                os={os}
                options={ctx.downloads[os]}
                version={version ?? null}
                releasesUrl={ctx.releasesUrl}
                detail="compact"
              />
            ))
          }
        </div>
      </div>
    </Stage>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: the desktop ---------- */
  /* The whole desktop fits the first screen: sky, copy, hills, characters. */
  :global(.stage.hero) {
    min-height: clamp(600px, calc(100svh - var(--header-h)), 900px);
  }

  .hero-inner {
    flex: 1;
    padding-block: clamp(40px, 8vh, 104px) calc(clamp(160px, 24vh, 260px) + 16px);
  }

  .hero-copy {
    max-width: 44rem;
  }

  .hero-copy h1 {
    max-width: 11em;
    font-size: clamp(2.6rem, 1.4rem + 3.6vw, 4.4rem);
    font-weight: 720;
    letter-spacing: -0.028em;
    line-height: 1;
    margin-bottom: var(--s-5);
  }

  .hero-lead {
    max-width: 33rem;
    margin-bottom: var(--s-6);
    color: var(--haze);
    font-size: var(--t-lg);
    line-height: 1.5;
  }

  .hero-meta {
    margin: var(--s-5) 0 0;
    color: var(--haze);
    font-size: var(--t-sm);
  }

  .hero-note {
    margin: var(--s-2) 0 0;
    color: var(--star);
    font-size: var(--t-sm);
  }

  /* A small caption on the grass, out of the characters' way. */
  .stage-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--s-4);
    margin: 0;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
  }

  .stage-hint span {
    max-width: none;
    color: var(--mist);
    font-size: var(--t-xs);
    text-align: right;
  }

  /* ---------- Sections ---------- */
  .acts-section {
    background: linear-gradient(180deg, var(--hill-near) 0, var(--night) 360px);
  }

  .roster {
    background: var(--dusk);
  }

  .how {
    border-top: 1px solid var(--line-soft);
  }

  .more {
    margin: var(--s-7) 0 0;
    font-weight: 700;
  }

  /* ---------- Download band, with characters on its edge ---------- */
  .get {
    padding-top: var(--s-7);
  }

  .get-inner {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-6) clamp(32px, 6vw, 96px);
    padding-block: 168px clamp(72px, 9vw, 120px);
  }

  .get-head h2 {
    font-size: var(--t-3xl);
    letter-spacing: -0.03em;
  }

  .get-head p {
    color: var(--haze);
  }

  .get-head .btn-row {
    margin-top: var(--s-5);
    gap: var(--s-5);
  }

  .get-list > :global(.platform:first-child) {
    border-top: 0;
    padding-top: 0;
  }

  @media (max-width: 960px) {
    .get-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    :global(.stage.hero) {
      min-height: 0;
    }

    .hero-inner {
      padding-bottom: 300px;
    }

    .stage-hint span {
      max-width: 22ch;
    }
  }
</style>
