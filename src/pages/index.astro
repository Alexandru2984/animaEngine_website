---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClipPlayer from '../components/ClipPlayer.astro';
import ClipShowcase from '../components/ClipShowcase.astro';
import HeroWalker from '../components/HeroWalker.astro';
import FeatureGroups from '../components/FeatureGroups.astro';
import CompatibilityTable from '../components/CompatibilityTable.astro';
import ArchitectureSection from '../components/ArchitectureSection.astro';
import PlatformDownloads from '../components/PlatformDownloads.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { clips } from '../data/media';
import { links, site } from '../data/site';
import { getDownloadContext } from '../lib/site-downloads';
import { PLATFORM_OSES } from '../lib/downloads';
import { formatDate, isoDay } from '../lib/format';
import { softwareApplication } from '../lib/structured-data';
import { clipPoster } from '../lib/posters';

const ctx = getDownloadContext();
const heroClip = clips.find((c) => c.id === 'desktop')!;
const heroPoster = await clipPoster(heroClip);
---

<BaseLayout description={site.description} jsonLd={[softwareApplication(ctx.latest)]} preloadImage={heroPoster.src}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Open source · Native, written in Rust</p>
        <h1 id="hero-title">Animated characters that live on your desktop</h1>
        <p class="lead">
          animaEngine draws characters in a transparent overlay above your windows. They walk, bounce, follow each other and
          play tag — and every click passes straight through to your work.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/download/" data-os-cta>
            <Icon name="download" />
            <span data-os-cta-label>Download</span>
          </a>
          <a class="btn" href={links.repo} rel="noopener noreferrer">
            <Icon name="github" />
            <span>View on GitHub</span>
          </a>
        </div>
        <p class="hero-meta">
          {ctx.latest && <span>Version {ctx.latest.version}</span>}
          <span>Linux · Windows (experimental)</span>
          <span>MIT licence</span>
          <span>No network connections</span>
        </p>
        <p class="hero-note" data-os-cta-note hidden></p>
      </div>
      <div class="hero-media">
        <div class="glow" aria-hidden="true"></div>
        <ClipPlayer clip={heroClip} autoplay idPrefix="hero" showCaption={false} />
        <p class="media-note">A recording of animaEngine on the project’s test rig: the built-in characters walking and floating.</p>
      </div>
    </div>
    <HeroWalker />
  </section>

  <section class="section" id="features" aria-labelledby="features-title">
    <div class="container">
      <SectionHeader id="features-title" eyebrow="What it does" title="A small world on top of your work">
        Bring your own pictures or use the ten built-in characters. Give them as much life as you like, and they stay out
        of your way.
      </SectionHeader>
      <FeatureGroups />
      <p class="more"><a class="link-arrow" href="/features/">Every feature in detail <Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <section class="section section-alt" id="showcase" aria-labelledby="showcase-title">
    <div class="container">
      <SectionHeader id="showcase-title" eyebrow="Showcase" title="See it move">
        Short, silent recordings of the real app. Pick one to watch.
      </SectionHeader>
      <ClipShowcase idPrefix="home" />
      <p class="more"><a class="link-arrow" href="/showcase/">Screenshots and all ten characters <Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <section class="section" id="compatibility" aria-labelledby="compat-title">
    <div class="container">
      <SectionHeader id="compat-title" eyebrow="Compatibility" title="Where it runs">
        Linux first. Each status below is what the project itself reports for release {ctx.latest?.version ?? '1.5.1'}.
      </SectionHeader>
      <CompatibilityTable />
      <p class="more"><a class="link-arrow" href="/docs/linux-desktops/">X11, Wayland and the known limitations <Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <section class="section section-alt" id="architecture" aria-labelledby="arch-title">
    <div class="container">
      <SectionHeader id="arch-title" eyebrow="Under the hood" title="Native, light, and quiet when idle">
        A desktop companion runs from login to shutdown, so animaEngine is built to cost next to nothing while nothing
        moves.
      </SectionHeader>
      <ArchitectureSection />
    </div>
  </section>

  <section class="section download-cta" id="download" aria-labelledby="download-title">
    <div class="container">
      <SectionHeader id="download-title" eyebrow="Download" title="Get animaEngine" center>
        {
          ctx.latest ? (
            <>
              Version {ctx.latest.version}, released <time datetime={isoDay(ctx.latest.publishedAt)}>{formatDate(ctx.latest.publishedAt)}</time>.
              Free and open source.
            </>
          ) : (
            <>No downloadable release has been published yet.</>
          )
        }
      </SectionHeader>
      <div class="platforms">
        {
          PLATFORM_OSES.map((os) => (
            <PlatformDownloads
              os={os}
              options={ctx.downloads[os]}
              version={ctx.latest?.version ?? null}
              releasesUrl={ctx.releasesUrl}
              detail="compact"
            />
          ))
        }
      </div>
      <div class="cta-links">
        <a class="link-arrow" href="/download/">Checksums, install steps and file details <Icon name="arrow-right" /></a>
        <a class="link-arrow" href="/docs/installation/#from-source">Build from source <Icon name="arrow-right" /></a>
        <a class="link-arrow" href={ctx.latest?.url ?? ctx.releasesUrl} rel="noopener noreferrer">Release on GitHub <Icon name="external" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: clamp(48px, 7vw, 96px) clamp(120px, 12vw, 170px);
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 85% 10%, rgb(107 79 216 / 0.32), transparent 70%),
      radial-gradient(40% 50% at 0% 0%, rgb(143 200 255 / 0.08), transparent 70%),
      linear-gradient(180deg, var(--bg) 0%, #151027 100%);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .hero-copy .lead {
    max-width: 34rem;
    margin-bottom: 28px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .hero-meta span {
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(31 28 42 / 0.6);
  }

  .hero-note {
    margin: 12px 0 0;
    color: var(--warn);
    font-size: 0.92rem;
  }

  .hero-media {
    position: relative;
  }

  .glow {
    position: absolute;
    inset: 8% 6% -4%;
    background: radial-gradient(closest-side, rgb(154 131 255 / 0.45), transparent);
    filter: blur(40px);
    pointer-events: none;
  }

  .hero-media :global(.frame) {
    position: relative;
    box-shadow:
      0 0 0 1px rgb(154 131 255 / 0.25),
      0 40px 90px -30px rgb(0 0 0 / 0.8);
  }

  .media-note {
    position: relative;
    margin: 12px 0 0;
    color: var(--faint);
    font-size: 0.85rem;
  }

  .more {
    margin: 32px 0 0;
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .cta-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 32px;
    margin-top: 32px;
  }

  .download-cta {
    background: radial-gradient(60% 50% at 50% 0%, rgb(107 79 216 / 0.18), transparent 70%);
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .platforms {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
