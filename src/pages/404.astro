---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stage from '../components/Stage.astro';
import type { CastMember } from '../data/stage';

const cast: CastMember[] = [
  { name: 'ghost', kind: 'floater', wideOnly: true },
  { name: 'cat', kind: 'walker' },
];
---

<BaseLayout
  title="Page not found"
  description="This page does not exist on animaengine.eu. Find animaEngine downloads, documentation and release notes from the home page."
  noindex
>
  <Stage class="lost" cast={cast} skyTop={24} size={{ wide: 80, narrow: 64 }}>
    <div class="container lost-inner">
      <div class="lost-copy" data-stage-avoid>
        <h1>This page wandered off</h1>
        <p class="lead">The address may be mistyped, or the page has moved.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/">Home</a>
          <a class="btn" href="/download/">Download</a>
          <a class="btn" href="/docs/">Documentation</a>
        </div>
        <p class="small muted">Looking for an older version? The <a href="/changelog/">changelog</a> lists every release.</p>
      </div>
    </div>
  </Stage>
</BaseLayout>

<style>
  :global(.stage.lost) {
    min-height: clamp(560px, calc(100svh - var(--header-h)), 820px);
  }

  .lost-inner {
    flex: 1;
    padding-block: clamp(40px, 8vh, 104px) calc(clamp(160px, 24vh, 260px) + 16px);
  }

  .lost-copy {
    max-width: 34rem;
  }

  .lost-copy h1 {
    font-size: clamp(2.6rem, 1.2rem + 4.4vw, 4.9rem);
    font-weight: 720;
    letter-spacing: -0.028em;
    line-height: 1;
    margin-bottom: var(--s-5);
  }

  .btn-row {
    margin: var(--s-6) 0 var(--s-5);
  }
</style>
