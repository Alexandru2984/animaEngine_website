---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { links } from '../../data/site';
import { breadcrumbs } from '../../lib/structured-data';

const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);

const reference = [
  { title: 'Configuration reference', text: 'Every field of config.toml.', href: links.docs.config },
  { title: 'Wayland setup', text: 'sway, Hyprland and river snippets for shortcuts.', href: links.docs.wayland },
  { title: 'Accessibility', text: 'Screen readers, keyboard reference, themes.', href: links.docs.accessibility },
  { title: 'Behaviour scripts', text: 'Example Rhai scripts for characters.', href: links.docs.behaviorExamples },
  { title: 'Stability policy', text: 'What stays the same across 1.x releases.', href: links.docs.stability },
  { title: 'Architecture', text: 'How the engine is put together.', href: links.docs.architecture },
  { title: 'Threat model', text: 'The security invariants the app keeps.', href: links.docs.threatModel },
  { title: 'Contributing', text: 'Building, testing and sending changes.', href: links.contributing },
];
---

<BaseLayout
  title="Documentation"
  description="Install, configure and use animaEngine: installation, getting started, configuration, Linux desktops and Wayland, and answers to common questions."
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Docs', path: '/docs/' }])]}
>
  <PageHeader title="Get it running, then make it yours">
    <p>Guides adapted from the documentation in the animaEngine repository, checked against release 1.5.1. Each page links to its source.</p>
  </PageHeader>

  <div class="container body">
    <section aria-labelledby="guides-title">
      <h2 id="guides-title" class="visually-hidden">Guides</h2>
      <ol class="guides">
        {
          pages.map((page) => (
            <li>
              <a class="guide" href={`/docs/${page.id}/`}>
                <span class="guide-title">{page.data.title}</span>
                <span class="guide-text">{page.data.description}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="reference" aria-labelledby="reference-title">
      <h2 id="reference-title">Reference in the repository</h2>
      <p class="muted">The detailed documents live next to the code on GitHub.</p>
      <ul>
        {
          reference.map((item) => (
            <li>
              <a href={item.href} rel="noopener noreferrer">
                <span>
                  {item.title}
                  <Icon name="external" size={15} />
                </span>
                <span class="ref-text">{item.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="note help">
        <Icon name="info" size={18} />
        <span>
          Stuck? Read the <a href="/docs/faq/">FAQ</a>, then <a href={links.newIssue} rel="noopener noreferrer">open an issue</a>
          with the diagnostic report from <em>Appearance → About</em>.
        </span>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .body {
    display: grid;
    gap: clamp(56px, 7vw, 88px);
    padding-block: var(--s-7) clamp(72px, 10vw, 136px);
  }

  /* The guides, in reading order, as a list of rows. */
  .guides {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .guides li {
    border-bottom: 1px solid var(--line);
  }

  .guide {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-2) var(--s-6);
    padding: var(--s-5) 0;
    color: var(--moon);
    text-decoration: none;
  }

  .guide-title {
    font-family: var(--display);
    font-size: var(--t-xl);
    font-weight: 760;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .guide-text {
    color: var(--haze);
    align-self: center;
  }

  .guide:hover .guide-title {
    text-decoration: underline 2px var(--star);
    text-underline-offset: 6px;
  }

  .reference h2 {
    margin-bottom: var(--s-2);
  }

  .reference ul {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5) var(--s-6);
  }

  .reference li a {
    display: grid;
    gap: 4px;
    color: var(--moon);
    font-weight: 700;
    text-decoration: none;
  }

  .reference li a > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .reference li a:hover > span:first-child {
    text-decoration: underline;
  }

  .ref-text {
    color: var(--haze);
    font-size: var(--t-sm);
    font-weight: 400;
  }

  .help {
    margin-top: var(--s-7);
  }

  @media (max-width: 960px) {
    .reference ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .guide {
      grid-template-columns: minmax(0, 1fr);
    }

    .reference ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
