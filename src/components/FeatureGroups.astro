---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { featureFacts, featureGroups } from '../data/features';
import { characterByName } from '../data/media';
---

<div class="groups">
  {
    featureGroups.map((group) => {
      const mascot = characterByName(group.mascot);
      return (
        <article class="group" aria-labelledby={`feature-${group.id}`}>
          <Image
            class="mascot"
            src={mascot.still}
            width={96}
            height={96}
            widths={[96, 192]}
            sizes="96px"
            format="webp"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <h3 id={`feature-${group.id}`}>{group.title}</h3>
          <p class="summary">{group.summary}</p>
          <ul>
            {group.points.map((point) => (
              <li>
                <Icon name="check" size={18} />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </article>
      );
    })
  }
</div>

<ul class="facts">
  {
    featureFacts.map((fact) => (
      <li>
        <span class="fact-icon">
          <Icon name={fact.icon} />
        </span>
        <div>
          <h3>{fact.title}</h3>
          <p>{fact.text}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .group {
    position: relative;
    padding: 28px 28px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(154 131 255 / 0.1), transparent 60%),
      var(--surface);
    overflow: hidden;
  }

  .mascot {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 88px;
    height: 88px;
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.35));
  }

  h3 {
    max-width: calc(100% - 100px);
    font-size: 1.35rem;
    margin-bottom: 8px;
  }

  .summary {
    max-width: calc(100% - 96px);
    color: var(--muted);
    margin-bottom: 18px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .group li {
    display: flex;
    gap: 10px;
    padding: 7px 0;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }

  .group li :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--ok);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .facts li {
    display: flex;
    gap: 16px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--bg-raised);
  }

  .fact-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .facts h3 {
    max-width: none;
    font-size: 1.05rem;
    margin-bottom: 4px;
  }

  .facts p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .groups,
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .group {
      padding: 22px 20px 18px;
    }

    .mascot {
      width: 64px;
      height: 64px;
      top: 16px;
      right: 14px;
    }

    h3,
    .summary {
      max-width: calc(100% - 64px);
    }
  }
</style>
