---
/**
 * A piece of animaEngine's dusk desktop with the built-in characters living
 * on it (src/scripts/stage.ts). Without JavaScript, or before it runs, the
 * scenery shows and the characters simply have not arrived; content passed
 * in the slot sits above them and stays fully usable.
 *
 * scenery="full"  sky, far hill, near hill (hero, 404)
 * scenery="ledge" one low hill strip, no sky (above the download section)
 */
import { FAR_HILL, LEDGE_HILL, NEAR_HILL, hillPath } from '../lib/stage/hills';
import { stageActors, type CastMember } from '../data/stage';
import { jsonForHtml } from '../lib/site-downloads';

interface Props {
  cast: CastMember[];
  scenery?: 'full' | 'ledge';
  entrance?: 'fall' | 'none';
  size?: { wide: number; narrow: number };
  /** Seconds without input before the characters doze. */
  dozeAfter?: number;
  /** px from the top that floaters keep clear of (the header). */
  skyTop?: number;
  class?: string;
}

const {
  cast,
  scenery = 'full',
  entrance = 'fall',
  size = { wide: 88, narrow: 64 },
  dozeAfter = 45,
  skyTop = 84,
  class: className,
} = Astro.props;

const actors = await stageActors(cast);
const config = jsonForHtml({ actors, ground: scenery === 'ledge' ? 'ledge' : 'near', entrance, size, dozeAfter });
const far = hillPath(FAR_HILL);
const near = hillPath(scenery === 'ledge' ? LEDGE_HILL : NEAR_HILL);
---

<div class:list={['stage', `stage-${scenery}`, className]} data-stage data-sky-top={skyTop}>
  <script type="application/json" data-stage-config set:html={config} />
  <div class="hills" aria-hidden="true">
    {
      scenery === 'full' && (
        <svg class="hill hill-far" viewBox="0 0 1440 240" preserveAspectRatio="none" focusable="false">
          <path d={far} />
        </svg>
      )
    }
    <svg class="hill hill-near" viewBox="0 0 1440 240" preserveAspectRatio="none" focusable="false" data-stage-ground>
      <path d={near} />
    </svg>
  </div>
  <div class="stage-layer" data-stage-layer></div>
  <div class="stage-content">
    <slot />
  </div>
</div>

<script>
  import '../scripts/stage';
</script>

<style>
  .stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

    /* The wallpaper's sky: deep at the top, lighter towards the horizon. */
  .stage-full {
    background: linear-gradient(180deg, var(--sky-top) 0%, #30245a 52%, var(--sky-low) 100%);
  }

  .hills {
    position: absolute;
    inset: auto 0 0;
    height: clamp(160px, 24vh, 260px);
    z-index: 1;
    pointer-events: none;
  }

  /* The ledge: a low hill whose fill becomes the band below it. */
  .stage-ledge {
    background: linear-gradient(180deg, transparent 0 151px, var(--hill-near) 151px);
  }

  .stage-ledge .hills {
    inset: 72px 0 auto;
    height: 80px;
  }

  .hill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hill-far path {
    fill: var(--hill-far);
  }

  .hill-near path {
    fill: var(--hill-near);
  }

  .stage-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .stage-content {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  /* Only real content takes the pointer; the empty sky and grass let
     clicks reach the characters, as the app lets them reach your windows. */
  .stage-content :global(:is([data-stage-avoid], a, button, input, select, textarea, label)) {
    pointer-events: auto;
  }

  /* Elements below are created by the script, so they carry no scoped attribute. */
  .stage :global(.actor) {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--size);
    height: var(--size);
    pointer-events: auto;
    cursor: pointer;
    will-change: transform;
    touch-action: manipulation;
  }

  .stage :global(.sprite) {
    width: 100%;
    height: 100%;
    background-repeat: no-repeat;
    background-size: 1200% 100%;
    background-position: 0 0;
    transform-origin: 50% 100%;
  }

  .stage :global(.sprite.still) {
    background-size: 100% 100%;
  }

  .stage :global(.actor-floater .sprite) {
    transform-origin: 50% 50%;
  }

  /* Speech bubbles, white with dark text as in the app. */
  .stage :global(.bubble) {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 6px);
    padding: 4px 10px;
    border-radius: 9px;
    background: #fbfaff;
    color: #241a3d;
    font-family: var(--text);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: 0 6px 14px -8px rgb(0 0 0 / 0.6);
    opacity: 0;
    translate: -50% 4px;
    transition:
      opacity var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .stage :global(.bubble::after) {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    margin-left: -5px;
    border: 5px solid transparent;
    border-top-color: #fbfaff;
  }

  .stage :global(.actor.talking .bubble) {
    opacity: 1;
    translate: -50% 0;
  }

  /* Characters arrive after the page: fade the layer in once they exist. */
  .stage-layer {
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .stage.stage-ready .stage-layer {
    opacity: 1;
  }
</style>
