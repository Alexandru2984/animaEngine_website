---
/**
 * The downloads for one operating system from the latest stable release.
 * Rendered at build time: works without JavaScript. Links point straight at
 * the files on GitHub Releases; nothing starts until the visitor clicks.
 */
import Icon from './Icon.astro';
import StatusBadge from './StatusBadge.astro';
import CopyButton from './CopyButton.astro';
import { ARCH_LABELS, type DownloadOption, type PlatformOS } from '../lib/downloads';
import { formatBytes } from '../lib/format';
import { OS_INFO } from '../lib/site-downloads';
import { links } from '../data/site';

interface Props {
  os: PlatformOS;
  options: DownloadOption[];
  version: string | null;
  releasesUrl: string;
  /** Full detail (file names, checksums) or a compact card. */
  detail?: 'full' | 'compact';
  headingLevel?: 2 | 3;
}

const { os, options, version, releasesUrl, detail = 'full', headingLevel = 3 } = Astro.props;
const info = OS_INFO[os];
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<section class:list={['platform', `platform-${os}`, detail]} id={`downloads-${os}`} data-platform={os} aria-labelledby={`downloads-${os}-title`}>
  <header class="head">
    <Heading id={`downloads-${os}-title`}>{info.name}</Heading>
    <StatusBadge status={info.status} />
    <span class="detected-tag" data-detected-tag hidden>Your system</span>
  </header>

  {
    options.length > 0 ? (
      <ul class="options">
        {options.map((option) => (
          <li class="option" id={`dl-${option.id}`}>
            <div class="option-text">
              <span class="option-label">{option.label}</span>
              <span class="option-summary">{option.summary}</span>
              {detail === 'full' && (
                <span class="option-meta">
                  <code>{option.fileName}</code>, {ARCH_LABELS[option.arch]}, {formatBytes(option.size)}
                </span>
              )}
            </div>
            <a
              class:list={['btn', detail === 'compact' ? 'btn-small' : null]}
              href={option.url}
              rel="noopener noreferrer"
            >
              <Icon name="download" size={18} />
              {detail === 'compact' ? (
                <span>
                  {option.label}
                  <span class="visually-hidden">
                    {' '}
                    for {info.name}, version {version}, {formatBytes(option.size)}
                  </span>
                </span>
              ) : (
                <span>
                  Download
                  <span class="visually-hidden">
                    {' '}
                    {option.label} for {info.name}, version {version}, {formatBytes(option.size)}
                  </span>
                </span>
              )}
            </a>
            {detail === 'full' && option.sha256 && (
              <div class="hash">
                <span class="hash-label">SHA-256</span>
                <code class="hash-value" id={`sha-${option.id}`}>
                  {option.sha256}
                </code>
                <CopyButton target={`sha-${option.id}`} label={`Copy the SHA-256 of ${option.fileName}`} />
              </div>
            )}
          </li>
        ))}
      </ul>
    ) : info.status === 'unsupported' || info.status === 'planned' ? (
      <p class="empty">{info.note}</p>
    ) : (
      <p class="empty">
        The {version ? `${version} release` : 'latest release'} has no {info.name} package.{' '}
        <a href={releasesUrl} rel="noopener noreferrer">See all releases on GitHub</a>.
      </p>
    )
  }

  {
    os === 'windows' && options.length > 0 && (
      <p class="note note-warn">
        <Icon name="alert" size={18} />
        <span>{detail === 'full' ? info.note : 'New in 1.5, tested under Wine so far; not signed yet, so SmartScreen asks first.'}</span>
      </p>
    )
  }
  {
    os === 'linux' && options.length > 0 && (
      <p class="note">
        <Icon name="info" size={18} />
        <span>
          {detail === 'full' ? info.note : 'x86_64 packages.'} Flatpak and AUR recipes are{' '}
          <a href="/docs/installation/#flatpak-built-locally">in the repository</a>, not yet published.
        </span>
      </p>
    )
  }
  {
    os === 'android' && options.length === 0 && (
      <p class="note">
        <Icon name="info" size={18} />
        <span>
          To hear when it is ready, watch the{' '}
          <a href={links.releases} rel="noopener noreferrer">releases on GitHub</a>.
        </span>
      </p>
    )
  }
  {
    os === 'macos' && (
      <p class="note">
        <Icon name="code" size={18} />
        <span>
          Interested in a port? <a href={links.contributing} rel="noopener noreferrer">Contributions are welcome.</a>
        </span>
      </p>
    )
  }
</section>

<script>
  // Marks the visitor's platform and labels "Download for …" buttons.
  import '../scripts/downloads';
</script>

<style>
  /* One row per system: the name and its status on the left, the files on the right. */
  .platform {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-3) var(--s-6);
    padding: var(--s-6) 0;
    border-top: 1px solid var(--line);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    align-content: start;
    gap: var(--s-2) var(--s-4);
  }

  .head :is(h2, h3) {
    margin: 0;
    width: 100%;
    font-size: var(--t-xl);
  }

  .detected-tag {
    color: var(--star);
    font-size: var(--t-sm);
    font-weight: 700;
  }

  .options,
  .empty {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .options {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
  }

  .option {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-2) var(--s-5);
    align-items: center;
  }

  .option + .option {
    padding-top: var(--s-4);
    border-top: 1px solid var(--line-soft);
  }

  .option-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .option-label {
    font-weight: 700;
  }

  .option-summary {
    color: var(--haze);
    font-size: var(--t-sm);
  }

  .option-meta {
    color: var(--mist);
    font-size: var(--t-xs);
    overflow-wrap: anywhere;
  }

  .hash {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--t-xs);
  }

  .hash-label {
    flex: none;
    color: var(--mist);
    font-weight: 700;
  }

  .hash-value {
    flex: 1;
    min-width: 0;
    padding: 0;
    background: none;
    color: var(--haze);
    word-break: break-all;
  }

  .empty {
    margin: 0;
    color: var(--haze);
    max-width: 56ch;
  }

  .platform :global(.note) {
    grid-column: 1;
    align-self: start;
    margin: 0;
  }

  .platform[data-detected] .head :is(h2, h3) {
    color: var(--moon);
  }

  @media (max-width: 760px) {
    .platform {
      grid-template-columns: minmax(0, 1fr);
    }

    .options,
    .empty,
    .platform :global(.note) {
      grid-column: 1;
      grid-row: auto;
    }

    .option {
      grid-template-columns: minmax(0, 1fr);
    }

    .option .btn {
      justify-self: start;
    }
  }
</style>
