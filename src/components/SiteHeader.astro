---
import Icon from './Icon.astro';
import { primaryNav, links, site } from '../data/site';
import { iconSvg } from '../data/media';

const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img src={iconSvg} width="32" height="32" alt="" />
      <span>{site.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-link" href={links.repo} rel="noopener noreferrer">
        <Icon name="github" label="animaEngine on GitHub" />
      </a>
      <a class="btn btn-primary btn-small download-btn" href="/download/" aria-current={isCurrent('/download/') ? 'page' : undefined}>
        <Icon name="download" size={18} />
        <span>Download</span>
      </a>
      <button class="menu-toggle" type="button" popovertarget="mobile-nav" aria-controls="mobile-nav">
        <Icon name="menu" />
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" popover aria-label="Main">
    <div class="mobile-head">
      <span class="brand-text">{site.name}</span>
      <button class="menu-close" type="button" popovertarget="mobile-nav" popovertargetaction="hide">
        <Icon name="close" />
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>
    <ul>
      <li><a href="/" aria-current={current === '/' ? 'page' : undefined}>Home</a></li>
      {
        primaryNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href="/download/" aria-current={isCurrent('/download/') ? 'page' : undefined}>Download</a></li>
      <li>
        <a href={links.repo} rel="noopener noreferrer">GitHub <Icon name="external" size={16} /></a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(16 14 23 / 0.82);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid rgb(46 42 61 / 0.8);
  }

  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-right: auto;
  }

  .brand img {
    width: 32px;
    height: 32px;
    border-radius: 9px;
  }

  .nav-desktop ul,
  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-desktop ul {
    display: flex;
    gap: 4px;
  }

  .nav-desktop a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 140ms, background-color 140ms;
  }

  .nav-desktop a:hover {
    color: var(--text);
    background: var(--surface);
  }

  .nav-desktop a[aria-current='page'] {
    color: var(--text);
    background: var(--accent-soft);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .icon-link,
  .menu-toggle,
  .menu-close {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 140ms, background-color 140ms;
  }

  .icon-link:hover,
  .menu-toggle:hover,
  .menu-close:hover {
    color: var(--text);
    background: var(--surface);
  }

  .menu-toggle {
    display: none;
    border-color: var(--border);
  }

  .nav-mobile {
    /* Popover in the top layer: no script needed to open, close or dismiss. */
    margin: 0;
    inset: 0 0 auto auto;
    width: min(340px, 100vw);
    height: 100dvh;
    max-height: none;
    padding: 12px var(--gutter) 32px;
    border: 0;
    border-left: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--text);
    overflow-y: auto;
  }

  .nav-mobile::backdrop {
    background: rgb(5 4 10 / 0.6);
  }

  .mobile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    margin-bottom: 16px;
  }

  .brand-text {
    font-weight: 800;
  }

  .nav-mobile a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-weight: 650;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .nav-mobile a[aria-current='page'] {
    color: var(--accent-strong);
  }

  @media (max-width: 880px) {
    .nav-desktop {
      display: none;
    }

    .menu-toggle {
      display: inline-grid;
    }
  }

  @media (max-width: 420px) {
    /* Visually hidden, still the button's accessible name. */
    .download-btn span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .download-btn {
      padding-inline: 12px;
    }

    .icon-link {
      display: none;
    }
  }
</style>
