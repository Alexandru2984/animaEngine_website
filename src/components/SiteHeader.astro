---
import Icon from './Icon.astro';
import { primaryNav, links, site } from '../data/site';
import { iconSvg } from '../data/media';

const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img src={iconSvg} width="30" height="30" alt="" />
      <span>{site.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-link" href={links.repo} rel="noopener noreferrer">
        <Icon name="github" label="animaEngine on GitHub" />
      </a>
      <a class="btn btn-primary btn-small download-btn" href="/download/" aria-current={isCurrent('/download/') ? 'page' : undefined}>
        <span>Download</span>
      </a>
      <button class="menu-toggle" type="button" popovertarget="mobile-nav" aria-controls="mobile-nav">
        <Icon name="menu" />
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" popover aria-label="Main">
    <div class="mobile-head">
      <span class="brand-text">{site.name}</span>
      <button class="menu-close" type="button" popovertarget="mobile-nav" popovertargetaction="hide">
        <Icon name="close" />
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>
    <ul>
      <li><a href="/" aria-current={current === '/' ? 'page' : undefined}>Home</a></li>
      {
        primaryNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href="/download/" aria-current={isCurrent('/download/') ? 'page' : undefined}>Download</a></li>
      <li>
        <a href={links.repo} rel="noopener noreferrer">Source on GitHub <Icon name="external" size={16} /></a>
      </li>
    </ul>
  </nav>
</header>

<style>
  /* The desktop's top bar: the same colour as the top of the sky. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--sky-top);
    border-bottom: 1px solid rgb(243 239 255 / 0.07);
  }

  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    color: var(--moon);
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 760;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand img {
    width: 30px;
    height: 30px;
    border-radius: 8px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--s-5);
  }

  .nav-desktop a {
    position: relative;
    display: block;
    padding: 6px 0;
    color: var(--haze);
    font-weight: 600;
    text-decoration: none;
  }

  .nav-desktop a:hover {
    color: var(--moon);
  }

  /* The current page: a short underline, like a selected tab. */
  .nav-desktop a[aria-current='page'] {
    color: var(--moon);
  }

  .nav-desktop a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--star);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .icon-link,
  .menu-toggle,
  .menu-close {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--r-control);
    background: transparent;
    color: var(--haze);
    cursor: pointer;
    transition: color var(--dur-quick) var(--ease-out);
  }

  .icon-link:hover,
  .menu-toggle:hover,
  .menu-close:hover {
    color: var(--moon);
  }

  .menu-toggle {
    display: none;
  }

  .nav-mobile {
    margin: 0;
    inset: 0 0 auto auto;
    width: min(340px, 100vw);
    height: 100dvh;
    max-height: none;
    padding: var(--s-3) var(--gutter) var(--s-6);
    border: 0;
    border-left: 1px solid var(--line);
    background: var(--dusk);
    color: var(--moon);
    overflow-y: auto;
  }

  .nav-mobile::backdrop {
    background: rgb(8 6 18 / 0.6);
  }

  .mobile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    margin-bottom: var(--s-4);
  }

  .brand-text {
    font-family: var(--display);
    font-weight: 760;
    font-size: 1.15rem;
  }

  .nav-mobile a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-soft);
    color: var(--moon);
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav-mobile a[aria-current='page'] {
    color: var(--star);
  }

  @media (max-width: 880px) {
    .nav-desktop {
      display: none;
    }

    .menu-toggle {
      display: inline-grid;
    }
  }

  @media (max-width: 380px) {
    .icon-link {
      display: none;
    }
  }
</style>
