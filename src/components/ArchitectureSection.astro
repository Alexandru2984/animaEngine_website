---
import { benchmarks, performanceFacts, pipeline } from '../data/architecture';
import { links } from '../data/site';
---

<div class="arch">
  <p class="stack">
    One native program, written in <strong>Rust</strong>. It draws with <strong>wgpu</strong> (Vulkan or OpenGL on Linux; DX12,
    Vulkan or GL on Windows), opens its windows with <strong>winit</strong> and, for native Wayland, Smithay's client toolkit,
    and builds its settings panel with <strong>egui</strong> and AccessKit. Behaviour scripts run in <strong>Rhai</strong>,
    sandboxed. No Electron, no Chromium, no web view.
  </p>

  <figure class="pipeline">
    <ol>
      {
        pipeline.map((stepItem, i) => (
          <li>
            <span class="no" aria-hidden="true">
              {i + 1}
            </span>
            <strong>{stepItem.title}</strong>
            <span class="what">{stepItem.text}</span>
          </li>
        ))
      }
    </ol>
    <figcaption>
      How a picture reaches your screen, from the project's <a href={links.docs.architecture} rel="noopener noreferrer"
        >architecture notes</a
      >.
    </figcaption>
  </figure>

  <dl class="facts">
    {
      performanceFacts.map((fact) => (
        <div>
          <dt>{fact.title}</dt>
          <dd>{fact.text}</dd>
        </div>
      ))
    }
  </dl>
</div>

{
  benchmarks.length > 0 && (
    <div class="table-wrap benchmarks">
      <table>
        <caption class="visually-hidden">Measured performance</caption>
        <thead>
          <tr>
            <th scope="col">Metric</th>
            <th scope="col">Result</th>
            <th scope="col">Conditions</th>
            <th scope="col">Version</th>
          </tr>
        </thead>
        <tbody>
          {benchmarks.map((b) => (
            <tr>
              <th scope="row">{b.metric}</th>
              <td>
                <a href={b.sourceUrl} rel="noopener noreferrer">
                  {b.value}
                </a>
              </td>
              <td>{b.conditions}</td>
              <td>{b.version}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

<style>
  .stack {
    max-width: 62ch;
    margin-bottom: var(--s-8);
    color: var(--haze);
    font-size: var(--t-lg);
    line-height: 1.55;
  }

  .stack strong {
    color: var(--moon);
    font-weight: 700;
  }

  /* A strip of frames, one per step: the order matters, so they are numbered. */
  .pipeline {
    margin: 0 0 var(--s-8);
  }

  .pipeline ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--r-media);
    overflow: hidden;
  }

  .pipeline li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: var(--s-5) var(--s-4);
    background: var(--dusk);
  }

  .pipeline li + li {
    border-left: 1px solid var(--line);
  }

  .no {
    color: var(--star);
    font-family: var(--display);
    font-size: var(--t-xl);
    font-weight: 800;
    line-height: 1;
  }

  .pipeline strong {
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 760;
    letter-spacing: -0.01em;
  }

  .what {
    color: var(--haze);
    font-size: var(--t-sm);
  }

  .pipeline figcaption {
    margin-top: var(--s-3);
    color: var(--mist);
    font-size: var(--t-sm);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-8);
    margin: 0;
  }

  dt {
    margin-bottom: var(--s-2);
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 760;
    letter-spacing: -0.01em;
  }

  dd {
    margin: 0;
    color: var(--haze);
    max-width: 52ch;
  }

  .benchmarks {
    margin-top: var(--s-7);
  }

  @media (max-width: 960px) {
    .pipeline ol {
      grid-template-columns: minmax(0, 1fr);
    }

    .pipeline li {
      grid-template-columns: 2.2rem minmax(0, 1fr);
      column-gap: var(--s-3);
    }

    .pipeline li .no {
      grid-row: span 2;
    }

    .pipeline li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
