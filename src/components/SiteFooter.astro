---
import { footerNav, site } from '../data/site';
import { iconSvg } from '../data/media';
import { getManifest } from '../lib/releases';
import { pickLatestStable } from '../lib/downloads';

const latest = pickLatestStable(getManifest().releases);
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <a class="brand" href="/">
        <img src={iconSvg} width="36" height="36" alt="" loading="lazy" decoding="async" />
        <span>{site.name}</span>
      </a>
      <p class="muted">{site.tagline}. Free and open source for Linux, with an experimental Windows build.</p>
      {
        latest && (
          <p class="small muted">
            Latest release: <a href={`/changelog/#${latest.tag}`}>{latest.version}</a>
          </p>
        )
      }
    </div>
    {
      footerNav.map((group) => (
        <nav class="col" aria-label={group.title}>
          <h2>{group.title}</h2>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={item.href} rel={item.external ? 'noopener noreferrer' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container legal">
    <p>
      © {year}
      {site.copyright}. animaEngine is released under the <a href={site.license.url} rel="noopener noreferrer">{site.license.name}</a>.
    </p>
    <p>This website sets no cookies and runs no analytics. <a href="/privacy/">Privacy</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--bg-raised);
    padding-block: 56px 28px;
    font-size: 0.95rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    color: var(--text);
    font-weight: 800;
    font-size: 1.15rem;
    text-decoration: none;
  }

  .brand img {
    border-radius: 10px;
  }

  .about p {
    max-width: 36ch;
  }

  h2 {
    margin: 4px 0 12px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li a {
    display: inline-block;
    padding: 5px 0;
    color: var(--muted);
    text-decoration: none;
  }

  li a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-size: 0.875rem;
  }

  .legal p {
    margin: 0;
  }

  .legal a {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
