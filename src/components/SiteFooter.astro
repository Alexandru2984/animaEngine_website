---
import { footerNav, site } from '../data/site';
import { iconSvg } from '../data/media';
import { getManifest } from '../lib/releases';
import { pickLatestStable } from '../lib/downloads';

const latest = pickLatestStable(getManifest().releases);
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <a class="brand" href="/">
        <img src={iconSvg} width="32" height="32" alt="" loading="lazy" decoding="async" />
        <span>{site.name}</span>
      </a>
      <p>
        {site.tagline}. Free and open source for Linux, with an experimental Windows build.
        {latest && <> The current release is <a href={`/changelog/#${latest.tag}`}>{latest.version}</a>.</>}
      </p>
    </div>
    {
      footerNav.map((group) => (
        <nav class="col" aria-label={group.title}>
          <h2>{group.title}</h2>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={item.href} rel={item.external ? 'noopener noreferrer' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container legal">
    <p>
      © {year}
      {site.copyright}. animaEngine is released under the <a href={site.license.url} rel="noopener noreferrer">{site.license.name}</a>.
    </p>
    <p>This site sets no cookies and runs no analytics. <a href="/privacy/">Privacy</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: var(--s-8) var(--s-6);
    border-top: 1px solid var(--line-soft);
    background: var(--night);
    font-size: var(--t-sm);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--s-3);
    color: var(--moon);
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 760;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand img {
    border-radius: 8px;
  }

  .about p {
    max-width: 34ch;
    margin: 0;
    color: var(--haze);
  }

  h2 {
    margin: 4px 0 var(--s-3);
    font-family: var(--text);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--mist);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li a {
    display: inline-block;
    padding: 5px 0;
    color: var(--haze);
    text-decoration: none;
  }

  li a:hover {
    color: var(--moon);
    text-decoration: underline;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line-soft);
    color: var(--mist);
  }

  .legal p {
    margin: 0;
  }

  .legal a {
    color: var(--haze);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
