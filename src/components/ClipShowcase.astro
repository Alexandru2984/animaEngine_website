---
/**
 * The four product clips with a list to switch between them. Without
 * JavaScript the list is a set of links and CSS (:target) shows the chosen
 * clip; src/scripts/tabs.ts upgrades it to ARIA tabs with the same layout, so
 * nothing moves when the script starts.
 */
import ClipPlayer from './ClipPlayer.astro';
import { clips } from '../data/media';

interface Props {
  idPrefix?: string;
}
const { idPrefix = 'showcase' } = Astro.props;
---

<div class="showcase" data-tabs>
  <nav class="tab-list" data-tab-list aria-label="Clips">
    {
      clips.map((clip, i) => (
        <a class="tab" href={`#${idPrefix}-${clip.id}`} data-tab={`${idPrefix}-${clip.id}`} data-selected={i === 0 ? '' : undefined}>
          <span class="tab-title">{clip.title}</span>
          <span class="tab-caption">{clip.caption}</span>
          <span class="tab-length">{clip.seconds} s</span>
        </a>
      ))
    }
  </nav>
  <div class="panels">
    {
      clips.map((clip) => (
        <div class="panel-item" id={`${idPrefix}-${clip.id}`} data-tab-panel>
          <ClipPlayer clip={clip} autoplay idPrefix={idPrefix} showCaption={false} />
        </div>
      ))
    }
  </div>
</div>

<script>
  import '../scripts/tabs';
</script>

<style>
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }

  .tab-list {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }

  .tab {
    display: grid;
    align-content: start;
    gap: 2px;
    flex: 1 0 200px;
    padding: 14px 16px;
    border-radius: var(--r-control);
    color: var(--haze);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .tab:hover {
    color: var(--moon);
    background: rgb(243 239 255 / 0.04);
  }

  .tab[data-selected] {
    background: var(--dusk);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--moon);
  }

  .tab[data-selected] .tab-title {
    text-decoration: underline 2px var(--star);
    text-underline-offset: 5px;
  }

  .tab-title {
    color: var(--moon);
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 760;
    letter-spacing: -0.01em;
  }

  .tab-caption {
    font-size: var(--t-sm);
    line-height: 1.45;
  }

  .tab-length {
    margin-top: 6px;
    color: var(--mist);
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums;
  }

  /* Without the script: the first clip, or the one the URL points at. */
  .showcase:not(.tabs-ready) .panel-item:not(:first-child) {
    display: none;
  }

  .showcase:not(.tabs-ready) .panels:has(> .panel-item:target) > .panel-item:not(:target) {
    display: none;
  }

  .showcase:not(.tabs-ready) .panels > .panel-item:target {
    display: block;
  }

  @media (min-width: 960px) {
    .showcase {
      grid-template-columns: 320px minmax(0, 1fr);
      align-items: start;
    }

    .tab-list {
      flex-direction: column;
      overflow: visible;
    }

    .tab {
      flex: none;
    }
  }
</style>
