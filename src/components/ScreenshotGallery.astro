---
/**
 * Screenshots from the test rig. Each thumbnail links to a large WebP; with
 * JavaScript the link opens a modal <dialog> instead (src/scripts/lightbox.ts).
 */
import { getImage, Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { screenshots } from '../data/media';

const items = await Promise.all(
  screenshots.map(async (shot) => ({
    shot,
    full: await getImage({ src: shot.image, width: 1920, format: 'webp', quality: 82 }),
  })),
);
---

<ul class="gallery" data-lightbox-group>
  {
    items.map(({ shot, full }, i) => (
      <li class:list={['item', { wide: i === 0 }]}>
        <figure>
          <a
            class="thumb"
            href={full.src}
            data-lightbox
            data-full-src={full.src}
            data-full-width={full.attributes.width}
            data-full-height={full.attributes.height}
            data-alt={shot.alt}
            data-caption={shot.caption}
          >
            <Picture
              src={shot.image}
              widths={[480, 800, 1200]}
              sizes={i === 0 ? '(min-width: 960px) 66vw, 100vw' : '(min-width: 960px) 33vw, (min-width: 640px) 50vw, 100vw'}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              alt={shot.alt}
              loading="lazy"
              decoding="async"
            />
            <span class="zoom" aria-hidden="true">
              <Icon name="expand" size={18} />
            </span>
            <span class="visually-hidden">(open larger)</span>
          </a>
          <figcaption>{shot.caption}</figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" data-lightbox-dialog aria-labelledby="lightbox-caption">
  <div class="lb-inner">
    <img data-lightbox-img alt="" />
    <div class="lb-bar">
      <p id="lightbox-caption" class="lb-caption" data-lightbox-caption></p>
      <div class="lb-controls">
        <button type="button" class="lb-btn" data-lightbox-prev>
          <Icon name="arrow-right" class="flip" size={20} /><span class="visually-hidden">Previous picture</span>
        </button>
        <span class="lb-count" data-lightbox-count></span>
        <button type="button" class="lb-btn" data-lightbox-next>
          <Icon name="arrow-right" size={20} /><span class="visually-hidden">Next picture</span>
        </button>
        <button type="button" class="lb-btn" data-lightbox-close>
          <Icon name="close" size={20} /><span class="visually-hidden">Close</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/lightbox';
</script>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .item.wide {
    grid-column: span 2;
    grid-row: span 2;
  }

  figure {
    margin: 0;
  }

  .thumb {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: #241c3f;
    aspect-ratio: 16 / 9;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .thumb:hover :global(img) {
    transform: scale(1.025);
  }

  .zoom {
    position: absolute;
    right: 10px;
    top: 10px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: rgb(16 14 23 / 0.75);
    color: #fff;
    opacity: 0;
    transition: opacity 160ms;
  }

  .thumb:hover .zoom,
  .thumb:focus-visible .zoom {
    opacity: 1;
  }

  figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.93rem;
  }

  .lightbox {
    width: min(1280px, 96vw);
    max-width: none;
    max-height: 96vh;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-l);
    background: var(--bg-raised);
    color: var(--text);
  }

  .lightbox::backdrop {
    background: rgb(5 4 10 / 0.85);
  }

  .lb-inner img {
    width: 100%;
    height: auto;
    max-height: calc(96vh - 80px);
    object-fit: contain;
    background: #241c3f;
  }

  .lb-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 12px 16px;
  }

  .lb-caption {
    margin: 0;
    color: var(--muted);
  }

  .lb-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .lb-count {
    min-width: 3.5em;
    color: var(--faint);
    font-size: 0.9rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .lb-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .lb-btn:hover {
    border-color: var(--accent);
  }

  .lb-btn :global(.flip) {
    transform: scaleX(-1);
  }

  @media (max-width: 960px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .item.wide {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
