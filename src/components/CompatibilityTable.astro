---
import StatusBadge from './StatusBadge.astro';
import InlineText from './InlineText.astro';
import { environments, linuxPackages } from '../data/platforms';

interface Props {
  showPackages?: boolean;
}
const { showPackages = true } = Astro.props;
---

<div class="table-wrap">
  <table class="compat">
    <caption class="visually-hidden">Where animaEngine runs</caption>
    <thead>
      <tr>
        <th scope="col">System</th>
        <th scope="col">Status</th>
        <th scope="col">What to know</th>
      </tr>
    </thead>
    <tbody>
      {
        environments.map((env) => (
          <tr>
            <th scope="row">
              {env.name}
              <span class="detail">{env.detail}</span>
            </th>
            <td>
              <StatusBadge status={env.status} />
            </td>
            <td class="notes">
              <InlineText text={env.notes} />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

{
  showPackages && (
    <div class="packages">
      <h3>Ways to install on Linux</h3>
      <dl>
        {linuxPackages.map((pkg) => (
          <div>
            <dt>
              {pkg.name} <StatusBadge status={pkg.status} />
            </dt>
            <dd>
              <InlineText text={pkg.text} />
            </dd>
          </div>
        ))}
      </dl>
    </div>
  )
}

<style>
  .compat {
    font-size: var(--t-md);
  }

  .compat th[scope='row'] {
    width: 30%;
    font-family: var(--display);
    font-size: var(--t-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .compat td:nth-child(2) {
    width: 16%;
    padding-top: 18px;
  }

  .detail {
    display: block;
    margin-top: 4px;
    font-family: var(--text);
    font-size: var(--t-sm);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--mist);
  }

  .notes {
    color: var(--haze);
    max-width: 60ch;
  }

  .packages {
    margin-top: var(--s-8);
  }

  .packages h3 {
    margin-bottom: var(--s-4);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s-5) var(--s-6);
    margin: 0;
  }

  dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin-bottom: 6px;
    font-weight: 700;
  }

  dd {
    margin: 0;
    color: var(--haze);
    font-size: var(--t-sm);
  }

  @media (max-width: 720px) {
    .compat thead {
      display: none;
    }

    .compat tr {
      display: grid;
      gap: 6px;
      padding: var(--s-4) 0;
      border-bottom: 1px solid var(--line-soft);
    }

    .compat th[scope='row'],
    .compat td {
      width: auto;
      padding: 0;
      border: 0;
    }
  }
</style>
