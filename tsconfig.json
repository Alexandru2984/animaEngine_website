{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "scripts/**/*", "worker/**/*", "*.mjs", "*.ts"],
  "exclude": ["dist", "node_modules", "site-assets", ".wrangler"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["node"]
  }
}
